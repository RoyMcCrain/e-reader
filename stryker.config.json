{
	"$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
	"testRunner": "command",
	"commandRunner": {
		"command": "bun test --no-env-file ./src/lib/reader ./src/server"
	},
	"coverageAnalysis": "off",
	"mutate": [
		"src/lib/reader/layout.ts",
		"src/lib/reader/progress.ts",
		"src/lib/reader/preferences.ts",
		"src/lib/reader/zip-entries.ts",
		"src/server/access.ts",
		"src/server/library.ts"
	],
	"ignorePatterns": [
		"**",
		"!package.json",
		"!tsconfig.json",
		"!src/lib/reader/*.ts",
		"!src/server/*.ts",
		"!src/lib/library/types.ts"
	],
	"concurrency": 2,
	"cleanTempDir": "always",
	"reporters": ["clear-text", "progress", "html", "json"]
}
