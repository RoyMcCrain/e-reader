{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"paths": {
			"#*": ["./src/*"]
		},
		"types": ["vite/client"]
	},
	"include": [
		"src",
		"tests",
		"playwright.config.ts",
		"vite.config.ts",
		"void.config.ts",
		"db/schema.ts",
		".void/bindings.d.ts"
	]
}
