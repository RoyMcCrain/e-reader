{
  "name": "e-reader",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "dev": "./node_modules/.bin/node ./node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "./node_modules/.bin/node ./node_modules/vite/bin/vite.js build",
    "preview": "./node_modules/.bin/node ./node_modules/vite/bin/vite.js preview --host 0.0.0.0",
    "typecheck": "bunx --bun --no-install tsc --noEmit",
    "test": "bun test",
    "test:e2e": "bunx --bun --no-install playwright test",
    "test:server": "./node_modules/.bin/node --test tests/server/*.integration.ts",
    "lint": "bunx --bun --no-install oxlint . --type-aware",
    "format": "bunx --bun --no-install oxfmt --write .",
    "format:check": "bunx --bun --no-install oxfmt --check ."
  },
  "dependencies": {
    "@tanstack/react-router": "^1.169.5",
    "@tanstack/react-start": "^1.169.5",
    "@zip.js/zip.js": "2.25.0",
    "foliate-js": "github:johnfactotum/foliate-js#78914ae",
    "jose": "6.2.17",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.3.0",
    "miniflare": "5.20261110.1-beta",
    "node": "26.13.1",
    "oxc-transform-react": "^0.158.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "^5.9.0",
    "vite": "8.3.8",
    "void": "1.9.1"
  }
}
