{
	"name": "e-reader",
	"private": true,
	"type": "module",
	"imports": {
		"#*": "./src/*"
	},
	"scripts": {
		"build": "./node_modules/.bin/node ./node_modules/vite/bin/vite.js build",
		"dev": "./node_modules/.bin/node ./node_modules/vite/bin/vite.js --host 0.0.0.0",
		"format": "bunx --bun --no-install oxfmt --write .",
		"format:check": "bunx --bun --no-install oxfmt --check .",
		"lint": "bunx --bun --no-install oxlint . --type-aware",
		"preview": "./node_modules/.bin/node ./node_modules/vite/bin/vite.js preview --host 0.0.0.0",
		"test": "./node_modules/.bin/node ./node_modules/vitest/vitest.mjs run --config vitest.config.ts",
		"test:d1": "./node_modules/.bin/node --test src/server/reading-positions-d1.test.ts",
		"test:e2e": "bunx --bun --no-install playwright test",
		"test:mutator": "./node_modules/.bin/node ./node_modules/@mizchi/mutator/dist/cli.js",
		"test:pwa": "bunx --bun --no-install playwright test --config playwright.pwa.config.ts",
		"test:r2": "./node_modules/.bin/node --test src/server/library-r2.test.ts",
		"typecheck": "bunx --bun --no-install tsc --noEmit"
	},
	"dependencies": {
		"@tanstack/react-router": "^1.169.5",
		"@tanstack/react-start": "^1.169.5",
		"@zip.js/zip.js": "2.25.0",
		"foliate-js": "github:johnfactotum/foliate-js#78914ae",
		"idb": "^8.0.4",
		"jose": "6.2.17",
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@mizchi/mutator": "0.3.0",
		"@playwright/test": "1.65.1",
		"@types/node": "26.6.6",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "6.3.0",
		"fake-indexeddb": "^6.2.8",
		"miniflare": "5.20261110.1-beta",
		"node": "26.13.1",
		"oxc-transform-react": "^0.158.0",
		"oxfmt": "0.78.0",
		"oxlint": "1.93.0",
		"oxlint-tsgolint": "7.0.2007",
		"typescript": "^5.9.0",
		"vite": "8.3.8",
		"vitest": "5.1.1",
		"void": "1.9.1",
		"yaml": "2.9.1"
	}
}
