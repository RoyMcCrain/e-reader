{
	"name": "e-reader",
	"private": true,
	"type": "module",
	"imports": {
		"#*": "./src/*"
	},
	"scripts": {
		"build": "vp build",
		"dev": "vp dev --host 0.0.0.0",
		"format": "vp fmt",
		"format:check": "vp fmt --check",
		"lint": "vp lint",
		"preview": "vp preview --host 0.0.0.0",
		"test": "vp test --config vitest.config.ts",
		"test:d1": "node --test src/server/reading-positions-d1.test.ts",
		"test:e2e": "playwright test",
		"test:mutator": "mutator",
		"test:mutator:e2e": "mutator --config-file mutator.playwright.config.json",
		"test:pwa": "playwright test --config playwright.pwa.config.ts",
		"test:r2": "node --test src/server/library-r2.test.ts",
		"typecheck": "vp exec tsc --noEmit"
	},
	"dependencies": {
		"@tanstack/react-router": "^1.169.5",
		"@tanstack/react-start": "^1.169.5",
		"@zip.js/zip.js": "2.25.0",
		"foliate-js": "github:johnfactotum/foliate-js#78914aef4466eb960965702401634c2cb348e9b1",
		"idb": "^8.0.4",
		"jose": "6.2.17",
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20261121.1",
		"@mizchi/mutator": "0.4.0",
		"@mizchi/mutator-playwright": "0.4.0",
		"@mizchi/mutator-vitest": "0.4.0",
		"@playwright/test": "1.65.1",
		"@types/node": "26.6.6",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "6.3.0",
		"fake-indexeddb": "^6.2.8",
		"miniflare": "5.20261110.1-beta",
		"oxc-transform-react": "^0.158.0",
		"typescript": "^5.9.0",
		"vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
		"vite-plus": "1.7.0",
		"vitest": "5.1.0",
		"void": "1.11.0",
		"yaml": "2.9.1"
	},
	"packageManager": "pnpm@10.26.1"
}
